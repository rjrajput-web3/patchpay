# PATCHPAY web app — environment variables (all public / non-secret)
# Copy to .env.local for local overrides. Never commit .env.local.

# NEAR network: "testnet" (current build target) or "mainnet" (future, owner-approved)
NEXT_PUBLIC_NETWORK_ID=testnet

# Escrow contract account. CURRENTLY A PLACEHOLDER — Track A deployment is
# pending funding. After deploy, set to the real contract account id.
NEXT_PUBLIC_CONTRACT_ACCOUNT=patchpay.testnet

# Public RPC endpoints (no keys needed)
NEXT_PUBLIC_NODE_URL=https://rpc.testnet.near.org
NEXT_PUBLIC_EXPLORER_URL=https://testnet.nearblocks.io
