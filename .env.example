# PATCHPAY environment — copy to .env (NEVER commit the real file)
# NEAR
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://rpc.testnet.fastnear.com
PATCHPAY_CONTRACT_ID=patchpay.p2deployer.testnet
DEPLOYER_ACCOUNT=p2deployer.testnet
# DEPLOYER_KEY=ed25519:...   # full-access key; keep in a 600-permission file, never commit

# OutLayer (testnet)
OUTLAYER_CONTRACT=outlayer.testnet
OUTLAYER_API=https://testnet-api.outlayer.ai
# VERIFIER_WASM_HASH=<sha256 of the Track-B github-pr-verifier build>  # set by owner after Track B

# GitHub (server-side only — never in frontend)
# GITHUB_TOKEN=<fine-grained PAT, public-repo read>  # stored as OutLayer encrypted secret, not here
